generator client {
  provider      = "prisma-client-js"
  binaryTargets  = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  PROVIDER
  ADMIN
}

enum Currency {
  EUR
  USD
  GBP
  JPY
  CHF
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum TransactionStatus {
  PENDING
  POSTED
  FAILED
}

enum BillStatus {
  UPCOMING
  PAID
  OVERDUE
}

enum BillPeriod {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum BudgetPeriod {
  WEEKLY
  MONTHLY
}

enum ConnectionStatus {
  CONNECTED
  SYNCING
  ERROR
}

enum IncomePeriod {
  ONCE
  WEEKLY
  MONTHLY
  YEARLY
}

model User {
  id                String            @id @default(cuid())
  firstName         String
  lastName          String
  email             String            @unique
  phone             String
  passwordHash      String
  role              Role              @default(CLIENT)
  preferredCurrency Currency          @default(EUR)
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  refreshTokens     RefreshToken[]
  accounts          Account[]
  bankConnections   BankConnection[]
  transactions      Transaction[]
  bills             Bill[]
  spendingLimits    SpendingLimit[]
  scheduledIncomes  ScheduledIncome[]
  savingsGoals      SavingsGoal[]

  @@index([role, isActive])
  @@index([createdAt])
}

model RefreshToken {
  id          String    @id @default(cuid())
  jti         String    @unique
  tokenHash   String    @unique
  familyId    String
  userId      String
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
  replacedById String?
  userAgent   String?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId, revokedAt])
  @@index([userId, expiresAt])
}

model BankConnection {
  id              String           @id @default(cuid())
  userId          String
  provider        String           @default("mock")
  externalItemId  String           @unique
  institutionName String
  status          ConnectionStatus @default(CONNECTED)
  lastSyncedAt    DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts        Account[]

  @@index([userId, createdAt])
}

model Account {
  id                 String          @id @default(cuid())
  userId             String
  bankConnectionId   String?
  name               String
  institutionName    String
  accountType        AccountType     @default(CHECKING)
  currency           Currency        @default(EUR)
  balance            Decimal         @default(0) @db.Decimal(14, 2)
  availableBalance   Decimal         @default(0) @db.Decimal(14, 2)
  roundUpsEnabled    Boolean         @default(false)
  isArchived         Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankConnection     BankConnection? @relation(fields: [bankConnectionId], references: [id], onDelete: SetNull)
  transactions       Transaction[]   @relation("SourceAccount")
  incomingTransfers  Transaction[]   @relation("DestinationAccount")
  bills              Bill[]

  @@index([userId, currency, isArchived])
  @@index([bankConnectionId])
}

model Transaction {
  id                  String            @id @default(cuid())
  userId              String
  accountId           String
  destinationAccountId String?
  type                TransactionType
  status              TransactionStatus @default(POSTED)
  description         String
  merchant            String?
  category            String            @default("Uncategorised")
  amount              Decimal           @db.Decimal(14, 2)
  roundUpAmount       Decimal           @default(0) @db.Decimal(14, 2)
  currency            Currency          @default(EUR)
  occurredAt          DateTime          @default(now())
  externalId          String?           @unique
  source              String            @default("manual")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  account             Account           @relation("SourceAccount", fields: [accountId], references: [id], onDelete: Restrict)
  destinationAccount  Account?          @relation("DestinationAccount", fields: [destinationAccountId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt(sort: Desc)])
  @@index([userId, category, occurredAt])
  @@index([accountId, occurredAt])
  @@index([userId, type, status, occurredAt])
}

model Bill {
  id               String      @id @default(cuid())
  userId           String
  accountId        String?
  title            String
  amount           Decimal     @db.Decimal(14, 2)
  currency         Currency    @default(EUR)
  category         String      @default("Bills")
  dueDate          DateTime
  status           BillStatus  @default(UPCOMING)
  recurringPeriod  BillPeriod?
  recurrenceGroupId String?
  autoPay          Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  account          Account?    @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([userId, dueDate, status])
  @@index([recurrenceGroupId, dueDate])
}

model SpendingLimit {
  id        String       @id @default(cuid())
  userId    String
  name      String
  category  String
  amount    Decimal      @db.Decimal(14, 2)
  currency  Currency     @default(EUR)
  period    BudgetPeriod @default(MONTHLY)
  enabled   Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, period])
  @@index([userId, enabled])
}

model ScheduledIncome {
  id          String       @id @default(cuid())
  userId      String
  description String
  amount      Decimal      @db.Decimal(14, 2)
  currency    Currency     @default(EUR)
  expectedAt  DateTime
  period      IncomePeriod @default(MONTHLY)
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expectedAt, active])
}

model SavingsGoal {
  id          String   @id @default(cuid())
  userId      String
  name        String
  targetAmount Decimal @db.Decimal(14, 2)
  currentAmount Decimal @default(0) @db.Decimal(14, 2)
  currency    Currency @default(EUR)
  targetDate  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, targetDate])
}
