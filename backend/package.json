{
  "name": "@billscope/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:generate": "node scripts/prisma.js generate",
    "db:migrate": "node scripts/prisma.js migrate dev --name init",
    "db:deploy": "node scripts/prisma.js migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:studio": "node scripts/prisma.js studio",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "11.1.0",
    "@fastify/helmet": "13.0.2",
    "@fastify/jwt": "9.1.0",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/websocket": "^11.3.4",
    "@prisma/client": "6.19.0",
    "argon2": "0.44.0",
    "dotenv": "16.6.1",
    "fastify": "5.12.5"
  },
  "devDependencies": {
    "prisma": "6.19.0",
    "vitest": "3.2.4"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
